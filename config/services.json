{
  "stripe": {
    "baseUrl": "https://api.stripe.com/v1",
    "authHeader": "Authorization",
    "contentType": "application/x-www-form-urlencoded",
    "actions": {
      "charge.create": {
        "method": "POST",
        "path": "/charges",
        "validation": {
          "amount": {
            "type": "number",
            "min": 1
          },
          "currency": {
            "type": "string",
            "required": true
          },
          "customer": {
            "type": "string",
            "required": true
          }
        }
      },
      "customer.create": {
        "method": "POST",
        "path": "/customers",
        "validation": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  },
  "calendly": {
    "baseUrl": "https://api.calendly.com",
    "authHeader": "Authorization",
    "contentType": "application/json",
    "actions": {
      "booking.create": {
        "method": "POST",
        "path": "/scheduled_events",
        "validation": {
          "start_time": {
            "type": "string",
            "required": true
          }
        }
      }
    }
  },
  "hubspot": {
    "baseUrl": "https://api.hubapi.com/crm/v3",
    "authHeader": "Authorization",
    "contentType": "application/json",
    "actions": {
      "contact.create": {
