            "type": "string",
            "format": "email"
          }
        }
      }
    }
  },
  "mockpay": {
    "baseUrl": "http://localhost:3000/internal",
    "internal": true,
    "contentType": "application/json",
    "actions": {
      "payment.create": {
        "method": "POST",
        "path": "/mockpay",
        "validation": {
          "amount": {
            "type": "number",
            "min": 1
          }
        }
      }
    }
  },
  "shopify": {
    "baseUrl": "https://YOUR_STORE.myshopify.com/admin/api/2024-01",
    "authHeader": "X-Shopify-Access-Token",
    "contentType": "application/json",
    "actions": {
      "order.create": {
        "method": "POST",
        "path": "/orders.json",
        "validation": {
          "line_items": {
            "type": "array",
            "required": true,
            "minLength": 1
          }
        }
      },
      "inventory.update": {
        "method": "PUT",
        "path": "/inventory_levels/set.json",
        "validation": {
          "inventory_item_id": {
            "type": "number",
            "required": true
          },
          "available": {
            "type": "number",
            "min": 0
          }
        }
      }
    }
  },
  "make": {
    "baseUrl": "https://hook.make.com",
    "authHeader": null,
    "authType": "none",
    "contentType": "application/json",
    "actions": {
      "scenario.trigger": {
        "method": "POST",
        "path": "/YOUR_WEBHOOK_PATH",
        "validation": {}
      }
    }
  },
  "zapier": {
    "baseUrl": "https://hooks.zapier.com",
    "authHeader": null,
    "authType": "none",
    "contentType": "application/json",
    "actions": {
      "action.execute": {
        "method": "POST",
        "path": "/hooks/catch/YOUR_ZAPIER_ID",
        "validation": {}
      }
    }
  },
  "zoho": {
    "baseUrl": "https://books.zoho.com/api/v3",
