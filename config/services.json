  "razorpay": {
    "baseUrl": "https://api.razorpay.com/v1",
    "authType": "basic",
    "contentType": "application/json",
    "actions": {
      "payment.create": {
        "method": "POST",
        "path": "/orders",
        "validation": {
          "amount": {
            "type": "number",
            "min": 100
          },
          "currency": {
            "type": "string",
            "required": true
          }
        }
      }
    }
  },
  "twilio": {
    "baseUrl": "https://api.twilio.com/2010-04-01",
    "authType": "basic",
    "contentType": "application/x-www-form-urlencoded",
    "actions": {
      "sms.send": {
        "method": "POST",
        "path": "/Accounts/{TWILIO_SID}/Messages.json",
        "validation": {
          "To": {
            "type": "string",
            "required": true
          },
          "Body": {
            "type": "string",
            "required": true,
            "maxLength": 1600
          }
        }
      }
    }
  },
  "whatsapp": {
    "baseUrl": "https://graph.facebook.com/v18.0",
    "authHeader": "Authorization",
    "contentType": "application/json",
    "actions": {
      "message.send": {
        "method": "POST",
        "path": "/{PHONE_ID}/messages",
        "validation": {
          "messaging_product": {
            "type": "string",
            "enum": [
              "whatsapp"
            ],
            "required": true
          },
          "to": {
            "type": "string",
            "required": true
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "template"
            ],
            "required": true
          }
        }
      }
    }
  },
