# Copy this file to .env and fill in real values. Never commit .env itself —
# it's already in .gitignore.

# ─── Core ───
NODE_ENV=development
# development | production — production enables the Secure flag on cookies,
# which requires HTTPS. Keep this as development for local/non-HTTPS testing.

PORT=3000

# ─── Data stores ───
REDIS_URL=redis://localhost:16379
DATABASE_URL=postgres://agentraas:CHANGE_ME@localhost:15432/agentraas
# In compose.yaml, these point at the container hostnames (ar-redis, ar-postgres)
# instead of localhost — that's expected, they're two different environments.

# ─── Security — server refuses to start without these two ───
JWT_SECRET=
# Signs dashboard login sessions. Generate with: openssl rand -base64 48

CREDENTIALS_ENCRYPTION_KEY=
# Encrypts user-submitted service credentials (Stripe keys, etc.) at rest.
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32

# ─── Tuning ───
AGENT_RATE_LIMIT_PER_MIN=300
# Requests per minute allowed per API key (or per org+agent identity when
# anonymous) across the webhook/SDK/MCP routes. Raise if you have legitimately
# high-throughput agents; this is a fixed-window limiter, not per-IP.

# ─── Usage limits (see LICENSE.md) ───
# self-hosted (default): shown to users, never blocks — self-host enforcement
# isn't technically meaningful on infrastructure we don't control.
# cloud: ONLY set this on a deployment you operate yourself — the monthly
# limit is then actually enforced (HTTP 402 once exceeded).
# ─── Public URL — used for links in emails (verification, password reset) ───
# and Connect Agent's webhook/MCP URLs. Must include the port if not 80/443.
# Change this for any real deployment — it does NOT default correctly for you.
PUBLIC_URL=http://localhost:13000

# LOCAL DEV / TEST CONVENIENCE ONLY — NEVER set this in production.
# Normally the register response only includes a dev_verify_url when SMTP
# isn't configured at all. This flag exposes it regardless, even with real
# SMTP active — useful if you're running the automated test suite on the
# same machine where you've also configured real email for manual testing.
# Setting this in production would let anyone skip proving they own an
# email address. Leave unset (or false) everywhere except your own dev box.
EXPOSE_DEV_VERIFY_URL=false

DEPLOYMENT_MODE=self-hosted
# Self-hosted has no usage limit, on any tier — see LICENSE.md Section 2.
# CLOUD_MONTHLY_LIMIT only applies when DEPLOYMENT_MODE=cloud (the free
# Cloud tier's technically-enforced cap; Agency/Enterprise raise it).
CLOUD_MONTHLY_LIMIT=500

# ─── Enterprise SSO — Agency/Enterprise only, not in this repo's source ───
# If you're on a tier that includes it: each org's IdP (issuer URL, client
# id/secret, allowed email domains) is configured via
# PUT /api/v1/auth/sso/:orgId/config (org-admin only), not env vars. The
# OIDC callback URL sent to every IdP is derived from PUBLIC_URL above:
# ${PUBLIC_URL}/api/v1/auth/sso/callback

# ─── Email (optional) — for the forgot-password flow ───
# Without these, forgot-password still works locally: the reset link is
# logged server-side instead of emailed. Set these for real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgentRaaS <no-reply@yourdomain.com>

# ─── Per-service credentials — legacy/operator-set fallback only ───
# Not required. Only used when a user hasn't added their own credential via the
# dashboard's Credentials panel for that org+service (see getCredential() in
# server.js). Format: AGENTRAAS_KEY_<SERVICE_NAME>_<ORG_ID> or
AGENCY_RATE_LIMIT_PER_MIN=2000
AGENCY_MAX_CLIENT_TENANTS=10
