{
  "name": "n8n-nodes-agentraas",
  "version": "0.1.0",
  "description": "Exactly-once execution for AI agent workflows — n8n node for AgentRaaS",
  "keywords": [
    "n8n-community-node-package",
    "agentraas",
    "idempotency",
    "reliability"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sumedhchatse/agentraas",
  "author": {
    "name": "Sumedh Chatse"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sumedhchatse/agentraas.git",
    "directory": "integrations/n8n-nodes-agentraas"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AgentRaaSApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AgentRaaS/AgentRaaS.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.4.0"
  }
}
